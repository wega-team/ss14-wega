uniform sampler2D SCREEN_TEXTURE;
uniform highp float strength;
uniform highp float threshold;
uniform highp float motion;

highp vec3 sampleScreen(highp vec2 p) {
    return zTextureSpec(SCREEN_TEXTURE, p).rgb;
}

void fragment() {
    highp float t = TIME * motion;
    highp float s = strength;
    highp vec2 aspect = vec2(SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x, 1.0);

    highp float angle = s * (0.045 * sin(t * 0.8) + 0.02 * sin(t * 1.9));
    highp float zoom = 1.0 + s * 0.06 * (0.5 + 0.5 * sin(t * 0.55));
    highp vec2 centered = (UV - 0.5) * aspect;
    centered = mat2(cos(angle), -sin(angle), sin(angle), cos(angle)) * centered / zoom;
    centered += s * vec2(0.018 * sin(t * 0.7), 0.024 * sin(t * 0.9 + 1.3));

    highp float narcosis = smoothstep(min(threshold, 0.999), 1.0, s);
    highp float radius = length(centered);
    highp float segment = 6.2832 / 6.0;
    highp float polar = mod(atan(centered.y, centered.x) + t * 0.12, segment);
    polar = abs(polar - segment * 0.5);
    highp vec2 kaleido = vec2(cos(polar), sin(polar)) * radius * (1.0 + 0.08 * sin(t * 0.6));

    highp float edge = 0.75 * (1.0 - narcosis);
    highp float reveal = mix(smoothstep(edge, edge + 0.35, length((UV - 0.5) * aspect)), 1.0, narcosis * narcosis);
    highp float blend = clamp(narcosis * reveal * (0.45 + 0.25 * sin(t * 0.5)), 0.0, 1.0);

    highp vec2 ghost = s * vec2(0.022 * sin(t * 1.1), 0.016 * cos(t * 0.8));
    highp vec2 swayUV = centered / aspect + 0.5;
    highp vec2 kaleidoUV = kaleido / aspect + 0.5;

    highp vec3 base = mix(sampleScreen(swayUV), sampleScreen(swayUV + ghost), 0.5 * s);
    highp vec3 mirrored = mix(sampleScreen(kaleidoUV), sampleScreen(kaleidoUV + ghost), 0.5 * s);
    highp vec3 color = mix(base, mirrored, blend);

    color = mix(color, color.gbr, narcosis * 0.12 * (0.5 + 0.5 * sin(t * 0.3)));
    color *= 1.0 - s * 0.25 * smoothstep(0.3, 0.8, length((UV - 0.5) * aspect) * 1.4142 / length(aspect));
    color = mix(color, color * vec3(0.95, 1.02, 0.9), s * 0.4);

    COLOR = vec4(color, 1.0);
}
