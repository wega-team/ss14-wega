veil-cult-title = Культ Ратвара
veil-cult-description = Верные последователи Ратвара среди нас...

objective-issuer-technology-god = [color=orange]Бог Технологий[/color]

veil-cult-role-greeting-human =
    Вы - Культист Ратвара!
    Вы часть культа, что служит Ратвару.
    Ваша цель - призвать аватар и привести культ к победе.
    В ваших руках листы латуни и заводная плита, что помогут вам собрать силу для призыва.
    Призовите портал в укромном месте и защитите его, призвав божество.
    Только так вы обеспечите победу!
veil-cult-role-greeting-animal = Вы - Существо Шестерень! Вы - часть тени, служите Геометрии Ратвару, Помогите своим братьям в призыве и откройте заблудшим глаза.

veil-cult-break-control =
    Туман перед глазами { $name } рассеялся, { GENDER($name) ->
        [male] он приходит в себя.
        [female] она приходит в себя.
        [epicene] они приходят в себя.
       *[neuter] оно приходит в себя.
    }

veil-cult-godcalled = [color=crimson]Победа Культа Ратвара[/color]
veil-cult-ritualconducted = [color=blue]Малая победа Культа Ратвара[/color]
veil-cult-neutral = [color=yellow]Ничейный исход[/color]
veil-cult-cultlose = [color=grey]Поражение Культа Ратвара[/color]

veil-cult-cond-godcalled = Ратвар был призван, его сила охватила станцию!
veil-cult-cond-ritualconducted = Ритуал не был завершён, Культ Ратвара только собрал силу, чтобы призвать Ратвара!
veil-cult-cond-neutral = Цели не выполнены, Культ Ратвара ничего не достиг.
veil-cult-cond-cultlose = Культ Ратвара потерпел поражение, жертвы не были принесены, и Ратвар не явилось.

