<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Loc 'ninja-blood-scan-window-title'}"
    MinSize="500 430"
    SetSize="500 430">

    <BoxContainer Orientation="Vertical" Margin="6" VerticalExpand="True">

        <!-- Section header: "Образцы" + "?" tooltip button -->
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 6">
            <Label Text="{Loc 'ninja-blood-scan-section-samples'}"
                   StyleClasses="LabelBig"
                   HorizontalExpand="True"
                   VerticalAlignment="Center" />
            <Button Name="BloodScanHelpButton" Text="?"
                    ToolTip="{Loc 'ninja-blood-scan-help-tooltip'}" />
        </BoxContainer>

        <!-- 3 vial slot columns -->
        <BoxContainer Orientation="Horizontal" VerticalExpand="True">

            <!-- Slot 0 -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="0 0 3 0">
                <Label Name="Slot0Title"
                       Text="{Loc 'ninja-blood-scan-slot-empty'}"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 2" />
                <PanelContainer Name="Slot0Panel" VerticalExpand="True" MinHeight="150">
                    <BoxContainer Orientation="Vertical"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="4">
                        <SpriteView Name="Slot0Sprite"
                                    OverrideDirection="South"
                                    Scale="4 4"
                                    SetSize="128 128"
                                    HorizontalAlignment="Center" />
                        <Label Name="Slot0Name"
                               Text="—"
                               HorizontalAlignment="Center"
                               Margin="0 4 0 0" />
                    </BoxContainer>
                </PanelContainer>
                <Button Name="Slot0Button"
                        Text="{Loc 'ninja-blood-scan-button-eject'}"
                        HorizontalExpand="True"
                        Margin="0 2 0 0" />
            </BoxContainer>

            <!-- Slot 1 -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="3 0">
                <Label Name="Slot1Title"
                       Text="{Loc 'ninja-blood-scan-slot-empty'}"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 2" />
                <PanelContainer Name="Slot1Panel" VerticalExpand="True" MinHeight="150">
                    <BoxContainer Orientation="Vertical"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="4">
                        <SpriteView Name="Slot1Sprite"
                                    OverrideDirection="South"
                                    Scale="4 4"
                                    SetSize="128 128"
                                    HorizontalAlignment="Center" />
                        <Label Name="Slot1Name"
                               Text="—"
                               HorizontalAlignment="Center"
                               Margin="0 4 0 0" />
                    </BoxContainer>
                </PanelContainer>
                <Button Name="Slot1Button"
                        Text="{Loc 'ninja-blood-scan-button-eject'}"
                        HorizontalExpand="True"
                        Margin="0 2 0 0" />
            </BoxContainer>

            <!-- Slot 2 -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="3 0 0 0">
                <Label Name="Slot2Title"
                       Text="{Loc 'ninja-blood-scan-slot-empty'}"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 2" />
                <PanelContainer Name="Slot2Panel" VerticalExpand="True" MinHeight="150">
                    <BoxContainer Orientation="Vertical"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="4">
                        <SpriteView Name="Slot2Sprite"
                                    OverrideDirection="South"
                                    Scale="4 4"
                                    SetSize="128 128"
                                    HorizontalAlignment="Center" />
                        <Label Name="Slot2Name"
                               Text="—"
                               HorizontalAlignment="Center"
                               Margin="0 4 0 0" />
                    </BoxContainer>
                </PanelContainer>
                <Button Name="Slot2Button"
                        Text="{Loc 'ninja-blood-scan-button-eject'}"
                        HorizontalExpand="True"
                        Margin="0 2 0 0" />
            </BoxContainer>

        </BoxContainer>

        <!-- Scan button row (red-tinted panel, centred — mirrors SS13 NoticeBox_red) -->
        <PanelContainer Name="ScanRowPanel" Margin="0 6">
            <Button Name="ScanButton"
                    Text="{Loc 'ninja-blood-scan-button-scan'}"
                    HorizontalAlignment="Center"
                    MinWidth="250"
                    Margin="0 4" />
        </PanelContainer>

        <!-- Progress bar + status label -->
        <BoxContainer Orientation="Vertical">
            <ProgressBar Name="ScanProgressBar"
                         MinValue="0"
                         MaxValue="100"
                         Value="0"
                         HorizontalExpand="True"
                         Margin="0 0 0 2" />
            <Label Name="ProgressLabel"
                   Text="{Loc 'ninja-blood-scan-progress-idle'}"
                   HorizontalAlignment="Center" />
        </BoxContainer>

    </BoxContainer>
</controls:FancyWindow>
