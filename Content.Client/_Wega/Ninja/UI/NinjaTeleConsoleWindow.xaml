<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Loc 'ninja-teleconsole-window-title'}"
    MinSize="360 180">

    <BoxContainer Orientation="Vertical" Margin="12">

        <Label Name="MainLabel"
               Text="{Loc 'ninja-teleconsole-prompt'}"
               HorizontalAlignment="Center"
               Margin="0 0 0 8"
               Align="Center" />

        <Label Name="WarningLabel"
               Visible="False"
               FontColorOverride="#ff6666"
               HorizontalAlignment="Center"
               Margin="0 0 0 10"
               Align="Center" />

        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 4 0 0">
            <Button Name="ConfirmButton"
                    Text="{Loc 'ninja-teleconsole-button-yes'}"
                    MinWidth="120"
                    Margin="0 0 8 0" />
            <Button Name="CancelButton"
                    Text="{Loc 'ninja-teleconsole-button-no'}"
                    MinWidth="120" />
        </BoxContainer>

    </BoxContainer>
</controls:FancyWindow>
